<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scoreboardLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_blue"
    android:padding="24dp">

    <!-- YOU WIN Trophy Image -->
    <ImageView
        android:id="@+id/winImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/you_win"
        android:contentDescription="You Win"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Gold Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/goldCard"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/cream"
        app:layout_constraintTop_toBottomOf="@id/winImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/goldMedal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/goldmedal" />

            <TextView
                android:id="@+id/goldScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_toEndOf="@id/goldMedal"
                android:text="57:04:24"
                android:fontFamily="@font/pixelify_sans"
                android:textColor="@color/orange"
                android:textSize="25sp"
                />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Silver Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/silverCard"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/cream"
        app:layout_constraintTop_toBottomOf="@id/goldCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/silverMedal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/silvermedal" />

            <TextView
                android:id="@+id/silverScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="49:04:04"
                android:textSize="25sp"
                android:fontFamily="@font/pixelify_sans"
                android:textColor="@color/orange"
                android:layout_toEndOf="@id/silverMedal"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bronze Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bronzeCard"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="@color/cream"
        app:layout_constraintTop_toBottomOf="@id/silverCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/bronzeMedal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:src="@drawable/bronzemedal" />

            <TextView
                android:id="@+id/bronzeScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="44:04:24"
                android:textSize="25sp"
                android:textColor="@color/orange"
                android:fontFamily="@font/pixelify_sans"
                android:layout_toEndOf="@id/bronzeMedal"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- View Leaderboard Button -->
    <Button
        android:id="@+id/viewLeaderboardBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="LEADERBOARD"
        android:layout_marginTop="32dp"
        android:textAllCaps="true"
        android:textSize="40sp"
        android:backgroundTint="@color/orange"
        android:textColor="@color/white"
        android:fontFamily="@font/pixelify_sans"
        app:layout_constraintTop_toBottomOf="@id/bronzeCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Play Again Button -->
    <Button
        android:id="@+id/playAgainBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="PLAY AGAIN"
        android:layout_marginTop="16dp"
        android:textAllCaps="true"
        android:textSize="40sp"
        android:backgroundTint="@color/orange"
        android:textColor="@color/white"
        android:fontFamily="@font/pixelify_sans"
        app:layout_constraintTop_toBottomOf="@id/viewLeaderboardBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>