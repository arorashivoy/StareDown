<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/leaderboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <!-- Top Stars Row -->
    <LinearLayout
        android:id="@+id/topStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/star" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/star" />

        <!-- Add more stars as needed -->
    </LinearLayout>

    <!-- Circular Trophy Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/trophyCard"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="150dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/dark_blue"
        app:layout_constraintTop_toBottomOf="@id/topStars"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/trophy"
            android:layout_width="120dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/trophy" />
    </androidx.cardview.widget.CardView>

    <!-- Leaderboard Container -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/leaderboardRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/trophyCard"
        app:layout_constraintBottom_toTopOf="@id/playBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- Leaderboard items will be added dynamically or via include -->

    </androidx.recyclerview.widget.RecyclerView>

    <!-- Play Button -->
    <Button
        android:id="@+id/playBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PLAY AGAIN"
        android:textColor="@color/white"
        android:textSize="35sp"
        android:fontFamily="@font/pixelify_sans"
        android:backgroundTint="@color/dark_blue"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomStars"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Stars -->
    <!-- Bottom Stars -->
    <LinearLayout
        android:id="@+id/bottomStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/star" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/star" />

        <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/star" />
        <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/star" />
        <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/star" />
        <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/star" />
        <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/star" />
        <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/star" />
        <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/star" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>