<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/orange"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Icon: Medal or Rank -->
        <FrameLayout
            android:id="@+id/rankIconContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical">

            <!-- Medal or number will be swapped programmatically -->
            <ImageView
                android:id="@+id/medalIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <androidx.cardview.widget.CardView
                android:id="@+id/rankCircle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/dark_blue">

                <TextView
                    android:id="@+id/rankNumber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/pixelify_sans" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Username -->
        <TextView
            android:id="@+id/username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="USERNAME"
            android:textColor="@color/dark_blue"
            android:fontFamily="@font/pixelify_sans"
            android:gravity="center"
            android:textSize="25sp" />

        <!-- Score -->
        <TextView
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/dark_blue"
            android:fontFamily="@font/pixelify_sans"
            android:textSize="20sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>